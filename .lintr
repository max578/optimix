linters: linters_with_defaults(
    assignment_linter(),
    indentation_linter(indent = 2L),
    infix_spaces_linter(),
    line_length_linter(80L),
    object_name_linter(
      styles = c("snake_case", "SNAKE_CASE", "symbols"),
      regexes = c(dot_internal = "^\\.[a-zA-Z][a-zA-Z0-9_]*$")
    ),
    quotes_linter(),
    semicolon_linter(),
    seq_linter(),
    T_and_F_symbol_linter()
  )
encoding: "UTF-8"
